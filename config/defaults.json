{
  "project": "Katana",
  "mode": "deterministic",
  "trigger": {"type": "folder-interval", "interval_min": 10},
  "max_iterations": 3,
  "max_stations": 20,
  "station_timeout_min": 60,
  "max_parallel": 2,
  "worktrees": false,
  "gates": {
    "test_command": "",
    "coverage_command": "",
    "when_unavailable": "warn",
    "security_source": "auto",
    "timeout_min": 10
  },
  "setup_completed": "",
  "budgets": {"run_tokens": 0, "daily_tokens": 0, "pause_near_limit": false},
  "notify": {
    "macos": true,
    "teams_webhook": "",
    "events": {"done": true, "failed": true, "blocked": true, "paused": true, "approval": true}
  },
  "custom_agents": {},
  "agents": {
    "orchestrator": {"model": "sonnet", "effort": "low"},
    "ba": {"model": "opus", "effort": "high"},
    "architect": {"model": "opus", "effort": "high"},
    "security": {"model": "opus", "effort": "high"},
    "developer": {"model": "sonnet", "effort": "medium"},
    "tester": {"model": "sonnet", "effort": "medium"},
    "reviewer": {"model": "opus", "effort": "high"},
    "general": {"model": "sonnet", "effort": "medium"}
  },
  "artifacts": [
    {"id": "tdd", "title": "Technical design (TDD)", "path": "docs/tdd.md",
     "description": "Business requirements, acceptance criteria and technical design"},
    {"id": "tasks", "title": "Task plan", "path": "docs/tasks.md",
     "description": "The checklist the Developer works through"},
    {"id": "security-tdd", "title": "Design security review", "path": "docs/security-tdd.md",
     "description": "Threats and controls found in the design"},
    {"id": "dev-notes", "title": "Developer notes", "path": "docs/dev-notes.md",
     "description": "What was built and the decisions taken"},
    {"id": "test-report", "title": "Test report", "path": "docs/test-report.md",
     "description": "Every acceptance criterion with PASS or FAIL"},
    {"id": "security-audit", "title": "Security audit", "path": "docs/security-audit.md",
     "description": "Findings in the code"},
    {"id": "review", "title": "Code review", "path": "docs/review.md",
     "description": "Must-fix and should-fix review items"},
    {"id": "gate-report", "title": "Gate report", "path": "docs/gate-report.md",
     "description": "Every finding behind a failed quality gate"}
  ],
  "pipeline": [
    [{"id": "tdd", "title": "Write TDD", "agent": "ba", "output": "docs/tdd.md",
      "inputs": ["requirements"], "outputs": ["tdd"],
      "task": "Write the business part of the TDD in docs/tdd.md from docs/00-requirements.md."}],
    [{"id": "tdd-refine", "title": "Refine TDD", "agent": "architect", "output": "docs/tdd.md",
      "inputs": ["requirements", "tdd"], "outputs": ["tdd", "tasks"],
      "task": "Refine docs/tdd.md: complete the technical design and write docs/tasks.md."}],
    [{"id": "tdd-security", "title": "Validate TDD security", "agent": "security", "output": "docs/security-tdd.md",
      "inputs": ["tdd"], "outputs": ["security-tdd"],
      "task": "Validate the design in docs/tdd.md before any code is written.",
      "pass": ["APPROVE"], "on_fail": "tdd-refine", "required": true, "gateway": "autonomous"}],
    [{"id": "build", "title": "Build", "agent": "developer", "output": "docs/dev-notes.md",
      "inputs": ["tdd", "tasks"], "outputs": ["code", "dev-notes"],
      "task": "Implement the tasks in docs/tasks.md as docs/tdd.md describes."}],
    [{"id": "test", "title": "Test", "agent": "tester", "output": "docs/test-report.md",
      "inputs": ["tdd", "code"], "outputs": ["test-report"],
      "task": "Test every acceptance criterion in docs/tdd.md."},
     {"id": "security-audit", "title": "Security audit", "agent": "security", "output": "docs/security-audit.md",
      "inputs": ["tdd", "code"], "outputs": ["security-audit"],
      "task": "Audit the code for security issues and check every control promised in docs/tdd.md."},
     {"id": "review", "title": "Code review", "agent": "reviewer", "output": "docs/review.md",
      "inputs": ["tdd", "code"], "outputs": ["review"],
      "task": "Review the code against docs/tdd.md."}],
    [{"id": "quality-gate", "title": "Quality gate", "kind": "gate", "output": "docs/gate-report.md",
      "inputs": ["test-report", "security-audit", "review", "code"], "outputs": ["gate-report"],
      "on_fail": "build", "required": true, "gateway": "autonomous",
      "conditions": [
        {"metric": "test_pass_rate", "op": ">=", "value": 100, "severity": "block"},
        {"metric": "coverage", "op": ">=", "value": 80, "severity": "block"},
        {"metric": "security_findings", "level": "high", "op": "<=", "value": 0, "severity": "block"},
        {"metric": "review_must_fix", "op": "<=", "value": 0, "severity": "block"}
      ]}]
  ]
}
